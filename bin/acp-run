#!/usr/bin/env bash
set -euo pipefail

# Resolve through symlinks so a linked ~/.local/bin/acp-run still finds the package root
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Prefer Node 22+ (adapter requires >=22). Use nvm if system node is older.
if [[ -z "${ACP_NODE:-}" ]]; then
  if command -v node >/dev/null 2>&1; then
    MAJOR="$(node -p "process.versions.node.split('.')[0]" 2>/dev/null || echo 0)"
  else
    MAJOR=0
  fi
  if [[ "$MAJOR" -lt 22 ]]; then
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    # shellcheck disable=SC1091
    [[ -s "$NVM_DIR/nvm.sh" ]] && . "$NVM_DIR/nvm.sh"
    unset NPM_CONFIG_PREFIX || true
    if command -v nvm >/dev/null 2>&1; then
      nvm use 22 >/dev/null 2>&1 || nvm use default >/dev/null 2>&1 || true
    fi
    if [[ -x "$NVM_DIR/versions/node/v22.23.4/bin/node" ]]; then
      export PATH="$NVM_DIR/versions/node/v22.23.4/bin:$PATH"
    fi
  fi
else
  export PATH="$(dirname "$ACP_NODE"):$PATH"
fi

NODE_BIN="${ACP_NODE:-$(command -v node)}"
MAJOR="$("$NODE_BIN" -p "process.versions.node.split('.')[0]")"
if [[ "$MAJOR" -lt 22 ]]; then
  echo "acp-run requires Node >= 22 (found $($NODE_BIN -v))" >&2
  exit 1
fi

export PATH="$ROOT/node_modules/.bin:$PATH"

if [[ -x "$ROOT/node_modules/.bin/tsx" ]]; then
  exec "$ROOT/node_modules/.bin/tsx" "$ROOT/src/cli.ts" "$@"
fi
exec "$NODE_BIN" --import tsx "$ROOT/src/cli.ts" "$@"
